# Copia este archivo como `.env.local` para desarrollo,
# y configura las mismas variables en Vercel (Settings → Environment Variables)
# para producción.
#
# Se obtienen creando una GitHub OAuth App:
#   https://github.com/settings/developers → New OAuth App
#
#   Application name:  Mika CMS
#   Homepage URL:      https://www.mikadigitalagency.com
#   Callback URL:      https://www.mikadigitalagency.com/api/callback
#
# El secreto NUNCA se sube al repositorio: .env.local está en .gitignore.

GITHUB_OAUTH_ID=
GITHUB_OAUTH_SECRET=
